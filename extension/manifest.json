{
  "manifest_version": 3,
  "name": "Mirelo Studio Knowledge Base",
  "version": "0.3.0",
  "description": "Named knowledge bases for the Mirelo Studio assistant.",
  "permissions": ["storage"],
  "host_permissions": ["https://mirelo.ai/*", "https://api.openai.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["content.js"],
      "matches": ["https://mirelo.ai/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://mirelo.ai/studio", "https://mirelo.ai/studio/*"],
      "js": ["inject.js"],
      "run_at": "document_idle"
    }
  ]
}
